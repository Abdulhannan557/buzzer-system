      <text font-family="Helvetica" font-size="16" font-weight="bold" text-anchor="middle" x="305" y="65">3-User Buzzer System with Scoring</text>
      <line x1="30" x2="580" y1="75" y2="75" stroke="#000000" stroke-width="1"/>
